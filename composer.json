{
	"name": "sy/bootstrap-wysiwyg",
	"description": "Shared WYSIWYG engine (CKEditor 4 wrapper) for the sy/bootstrap plugins",
	"type": "library",
	"require": {
		"php": ">=8.1",
		"ext-json": "*",
		"sy/webcomponent": "^2"
	},
	"license": "MIT",
	"authors": [
		{
			"name": "Syone",
			"email": "syone7@gmail.com"
		}
	],
	"autoload": {
		"psr-4": {
			"Sy\\Bootstrap\\Wysiwyg\\": "src/"
		}
	},
	"require-dev": {
		"phpunit/phpunit": "^10"
	},
	"autoload-dev": {
		"psr-4": {
			"Sy\\Test\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit --bootstrap tests/conf.php --coverage-text --coverage-filter src tests"
	}
}
